# Local Mac runtime. Copy this file to .env; never commit .env.
ENTERPRISE_RAG_CONFIG_FILE=config/macos.example.yaml
APP_ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:5173
MCP_PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://enterprise_rag:enterprise_rag@127.0.0.1:55432/enterprise_rag_dev
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Local development only. Production rejects this weak bootstrap pair.
ADMIN_BOOTSTRAP_EMAIL=admin
ADMIN_BOOTSTRAP_PASSWORD=admin

# OpenAI-compatible Chat Completions provider.
LLM_BASE_URL=https://tokenhub.yufamily.cn/v1
LLM_API_KEY=replace-with-your-token
LLM_MODEL=MiniMax-M3

# The Mac composition explicitly reuses the configured MiniMax LLM credentials for embedded-image captioning.
# It sends image bytes to the OpenAI-compatible endpoint, strips provider reasoning, and puts the final caption
# into retrieval_text before Embedding. Set this to none to keep images local without remote captioning.
ENTERPRISE_RAG__PROVIDERS__VISION=openai_compatible

# Default local profiles keep document/query text on this Mac.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional Chinese-focused FastEmbed profile: 512 dimensions and 512 input tokens.
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# ENTERPRISE_RAG__INGESTION__EMBEDDING_DIMENSION=512
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# Optional dedicated Vision endpoint (overrides the explicit Mac LLM credential reuse when complete).
# VISION_BASE_URL=https://vision.example/v1
# VISION_API_KEY=replace-with-your-vision-token
# VISION_MODEL=replace-with-a-multimodal-model

# Optional shared credential for remote profiles selected in /admin/providers.
# Embedding: BAAI/bge-m3 (1024 dimensions / 8192 input tokens)
# Reranker: BAAI/bge-reranker-v2-m3
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=replace-with-your-siliconflow-token
