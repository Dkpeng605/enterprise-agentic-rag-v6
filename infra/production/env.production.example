# Copy to infra/production/.env.production and replace every CHANGE_ME value.
PUBLIC_DOMAIN=rag.example.com
APP_COMMIT_SHA=replace-with-an-immutable-image-commit
BACKEND_IMAGE=ghcr.io/your-org/enterprise-agentic-rag-backend:replace-with-commit
FRONTEND_IMAGE=ghcr.io/your-org/enterprise-agentic-rag-frontend:replace-with-commit

POSTGRES_DB=enterprise_rag
POSTGRES_USER=enterprise_rag
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://enterprise_rag:CHANGE_ME@postgres:5432/enterprise_rag
SESSION_SECRET=CHANGE_ME_use_at_least_32_random_bytes
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_use_a_strong_password
MCP_TOKEN_PEPPER=CHANGE_ME_use_at_least_32_random_bytes
METRICS_TOKEN=CHANGE_ME_use_a_strong_random_token

ENTERPRISE_RAG__PROVIDERS__LLM=openai_compatible
ENTERPRISE_RAG__PROVIDERS__EMBEDDING=openai_compatible
ENTERPRISE_RAG__PROVIDERS__RERANKER=openai_compatible
ENTERPRISE_RAG__PROVIDERS__VECTOR_STORE=milvus_remote
ENTERPRISE_RAG__PROVIDERS__SPARSE_ENCODER=milvus_builtin_bm25
ENTERPRISE_RAG__PROVIDERS__VISION=none
ENTERPRISE_RAG__INGESTION__EMBEDDING_DIMENSION=1024

LLM_BASE_URL=https://llm.example/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME
EMBEDDING_BASE_URL=https://embedding.example/v1
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=https://rerank.example/v1
RERANK_API_KEY=CHANGE_ME
RERANK_MODEL=BAAI/bge-reranker-v2-m3
VECTOR_STORE_URI=https://milvus.example
VECTOR_STORE_TOKEN=CHANGE_ME
VECTOR_STORE_DATABASE=enterprise_rag
